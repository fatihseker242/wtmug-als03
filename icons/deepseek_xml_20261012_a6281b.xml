<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4a90e2"/>
      <stop offset="100%" stop-color="#2c5fa8"/>
    </linearGradient>
    <linearGradient id="sunGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffe066"/>
      <stop offset="100%" stop-color="#ffb300"/>
    </linearGradient>
    <linearGradient id="cloudGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#d6e4f0"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Arka plan (yuvarlatılmış kare) -->
  <rect x="0" y="0" width="512" height="512" rx="96" ry="96" fill="url(#skyGrad)"/>

  <!-- Güneş -->
  <g filter="url(#shadow)">
    <circle cx="220" cy="200" r="80" fill="url(#sunGrad)"/>
    <!-- Güneş ışınları -->
    <g stroke="#ffe066" stroke-width="14" stroke-linecap="round">
      <line x1="220" y1="80"  x2="220" y2="55"/>
      <line x1="220" y1="320" x2="220" y2="345"/>
      <line x1="100" y1="200" x2="75"  y2="200"/>
      <line x1="340" y1="200" x2="365" y2="200"/>
      <line x1="135" y1="115" x2="118" y2="98"/>
      <line x1="305" y1="285" x2="322" y2="302"/>
      <line x1="135" y1="285" x2="118" y2="302"/>
      <line x1="305" y1="115" x2="322" y2="98"/>
    </g>
  </g>

  <!-- Bulut -->
  <g filter="url(#shadow)">
    <path d="M 150 360
             a 60 60 0 0 1 60 -60
             a 75 75 0 0 1 145 -10
             a 55 55 0 0 1 47 70
             z"
          fill="url(#cloudGrad)"
          stroke="#b8cfe5" stroke-width="2"/>
    <ellipse cx="230" cy="345" rx="55" ry="30" fill="#ffffff" opacity="0.6"/>
  </g>

  <!-- Yağmur damlaları -->
  <g stroke="#7fc4ff" stroke-width="10" stroke-linecap="round" opacity="0.85">
    <line x1="180" y1="400" x2="170" y2="440"/>
    <line x1="230" y1="405" x2="220" y2="445"/>
    <line x1="280" y1="400" x2="270" y2="440"/>
    <line x1="330" y1="405" x2="320" y2="445"/>
  </g>
</svg>